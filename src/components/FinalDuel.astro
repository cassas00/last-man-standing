---
import type { ResolvedPlayer } from '../utils/engine';
import { getTeam } from '../data/game';

interface Props {
  playerA: ResolvedPlayer;
  playerB: ResolvedPlayer;
  currentRound: number;
  revealPicks?: boolean;
  roundLabel?: string;
}

const { playerA, playerB, currentRound, revealPicks = false, roundLabel } = Astro.props;

function initials(name: string): string {
  const parts = name.trim().split(/\s+/);
  if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  return name.slice(0, 2).toUpperCase();
}

function fighterData(player: ResolvedPlayer) {
  const pick = player.picks.find((p) => p.round === currentRound);
  const team = pick && revealPicks ? getTeam(pick.teamId) : undefined;
  const pickHidden = !!(pick && !revealPicks);
  const accent = team?.color ?? 'var(--red-fire)';
  let status = '';
  let statusClass = '';
  if (pick && revealPicks && pick.won === true) {
    status = 'WIN';
    statusClass = 'status-alive';
  } else if (pick && revealPicks && pick.won === false) {
    status = 'LOSS';
    statusClass = 'status-dead';
  } else if (pick && revealPicks) {
    status = 'PENDING';
    statusClass = 'final-duel__status--pending';
  }
  return { pick, team, pickHidden, accent, status, statusClass };
}

const a = fighterData(playerA);
const b = fighterData(playerB);
---

<div class="final-duel mk-panel animate-fight">
  <header class="final-duel__header">
    <p class="final-duel__eyebrow">Head to head</p>
    <h2 class="final-duel__title">⚔ Final Kombat ⚔</h2>
    <p class="final-duel__sub">
      {roundLabel
        ? `${roundLabel} decides the champion — one pick, one survivor.`
        : 'Two fighters remain. One pick decides it all.'}
    </p>
  </header>

  <div class="final-duel__arena">
    <div class="final-duel__fighter final-duel__fighter--left" style={`--accent: ${a.accent}`}>
      <div class="final-duel__glow" aria-hidden="true"></div>
      <div class="final-duel__avatar">{initials(playerA.name)}</div>
      <h3 class="final-duel__name">{playerA.name}</h3>
      {a.pickHidden ? (
        <span class="final-duel__pick final-duel__pick--hidden">PICKED</span>
      ) : a.team ? (
        <span class="final-duel__pick" style={`--team-color: ${a.team.color}`}>{a.team.short}</span>
      ) : (
        <span class="final-duel__pick final-duel__pick--none">No pick</span>
      )}
      {a.status && <span class:list={['final-duel__status', a.statusClass]}>{a.status}</span>}
      <div class="final-duel__health">
        <div class="final-duel__health-bar"></div>
      </div>
    </div>

    <div class="final-duel__center">
      <span class="final-duel__vs">VS</span>
      <span class="final-duel__spark" aria-hidden="true">✦</span>
    </div>

    <div class="final-duel__fighter final-duel__fighter--right" style={`--accent: ${b.accent}`}>
      <div class="final-duel__glow" aria-hidden="true"></div>
      <div class="final-duel__avatar">{initials(playerB.name)}</div>
      <h3 class="final-duel__name">{playerB.name}</h3>
      {b.pickHidden ? (
        <span class="final-duel__pick final-duel__pick--hidden">PICKED</span>
      ) : b.team ? (
        <span class="final-duel__pick" style={`--team-color: ${b.team.color}`}>{b.team.short}</span>
      ) : (
        <span class="final-duel__pick final-duel__pick--none">No pick</span>
      )}
      {b.status && <span class:list={['final-duel__status', b.statusClass]}>{b.status}</span>}
      <div class="final-duel__health">
        <div class="final-duel__health-bar"></div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .final-duel {
    max-width: 720px;
    width: 100%;
    margin: 1.5rem auto 2rem;
    padding: 0.5rem;
    overflow: hidden;
    border-color: rgba(255, 69, 69, 0.45);
    box-shadow:
      0 0 40px rgba(255, 69, 69, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .final-duel__header {
    text-align: center;
    padding: 2rem 2rem 1.5rem;
    background: linear-gradient(180deg, rgba(139, 0, 0, 0.22) 0%, transparent 100%);
    border-bottom: 1px solid rgba(255, 69, 69, 0.2);
  }

  .final-duel__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-dim);
    margin-bottom: 0.35rem;
  }

  .final-duel__title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    color: var(--red-fire);
    letter-spacing: 0.15em;
    text-shadow: 0 0 20px var(--red-fire);
    animation: fight-flash 2.5s ease-in-out infinite;
  }

  .final-duel__sub {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 36rem;
    margin-inline: auto;
  }

  .final-duel__arena {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    justify-items: center;
    min-height: 300px;
    padding: 1.25rem 0.75rem 1.5rem;
  }

  .final-duel__fighter {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem 1.75rem;
    text-align: center;
    overflow: hidden;
    width: 100%;
  }

  .final-duel__fighter--left {
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, transparent) 0%, transparent 70%);
  }

  .final-duel__fighter--right {
    background: linear-gradient(225deg, color-mix(in srgb, var(--accent) 12%, transparent) 0%, transparent 70%);
  }

  .final-duel__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 65%);
    pointer-events: none;
  }

  .final-duel__avatar {
    position: relative;
    z-index: 1;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.75rem;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    background: var(--bg-card);
    border: 2px solid var(--accent);
    box-shadow:
      0 0 24px color-mix(in srgb, var(--accent) 45%, transparent),
      inset 0 0 20px color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .final-duel__name {
    position: relative;
    z-index: 1;
    font-size: clamp(1.15rem, 3vw, 1.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-primary);
    max-width: 14rem;
  }

  .final-duel__pick {
    position: relative;
    z-index: 1;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.35rem;
    padding: 0.25rem 0.85rem;
    background: color-mix(in srgb, var(--team-color) 28%, transparent);
    border: 1px solid var(--team-color);
    color: var(--team-color);
    letter-spacing: 0.12em;
    text-shadow: 0 0 12px color-mix(in srgb, var(--team-color) 50%, transparent);
  }

  .final-duel__pick--hidden,
  .final-duel__pick--none {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
    text-shadow: none;
  }

  .final-duel__status {
    position: relative;
    z-index: 1;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .final-duel__status--pending {
    color: var(--text-muted);
  }

  .final-duel__health {
    position: relative;
    z-index: 1;
    width: min(100%, 10rem);
    height: 5px;
    margin-top: 0.25rem;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .final-duel__health-bar {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--green-alive), #2ecc71);
    box-shadow: 0 0 10px var(--green-alive);
  }

  .final-duel__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 1rem;
    position: relative;
  }

  .final-duel__center::before {
    content: '';
    position: absolute;
    top: 10%;
    bottom: 10%;
    left: 50%;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(255, 69, 69, 0.5), transparent);
    transform: translateX(-50%);
  }

  .final-duel__vs {
    position: relative;
    z-index: 1;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2rem, 6vw, 3rem);
    color: var(--red-fire);
    text-shadow:
      0 0 20px var(--red-fire),
      0 0 40px rgba(255, 69, 69, 0.4);
    animation: duel-vs-pulse 1.8s ease-in-out infinite;
  }

  .final-duel__spark {
    position: relative;
    z-index: 1;
    font-size: 0.85rem;
    color: var(--gold);
    opacity: 0.7;
    animation: duel-spark 2s ease-in-out infinite;
  }

  @keyframes duel-vs-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }

  @keyframes duel-spark {
    0%, 100% { opacity: 0.35; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  @media (max-width: 640px) {
    .final-duel {
      margin: 1rem auto 1.5rem;
      padding: 0.35rem;
    }

    .final-duel__header {
      padding: 1.5rem 1.25rem 1.25rem;
    }

    .final-duel__arena {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      min-height: unset;
      padding: 0.75rem 0.5rem 1rem;
    }

    .final-duel__center {
      flex-direction: row;
      padding: 1rem;
    }

    .final-duel__center::before {
      top: 50%;
      bottom: auto;
      left: 10%;
      right: 10%;
      width: auto;
      height: 1px;
      transform: translateY(-50%);
    }

    .final-duel__fighter {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
