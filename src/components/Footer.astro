---
import { game } from '../data/game';

interface Props {
  showHome?: boolean;
}

const { showHome = false } = Astro.props;
---

<footer class="site-footer">
  {showHome && (
    <p class="site-footer__nav">
      <a href="/" class="site-footer__link">← Home</a>
    </p>
  )}
  <p class="site-footer__copy">
    Last Man Standing · {game.subtitle} · {new Date().getFullYear()}
    <span class="site-footer__sep"> · </span>
    <a href="/admin" class="site-footer__link">Admin</a>
  </p>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    text-align: center;
    padding: 1.5rem;
    border-top: 1px solid rgba(255, 26, 26, 0.2);
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .site-footer__nav {
    margin-bottom: 0.75rem;
  }

  .site-footer__link {
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .site-footer__link:hover {
    color: var(--gold);
  }

  .site-footer__sep {
    color: rgba(255, 255, 255, 0.2);
  }
</style>
