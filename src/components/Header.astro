---
import { game } from '../data/game';

const nav = [
  { href: '/enter', label: 'Submit Pick' },
  { href: '/', label: 'Arena' },
  { href: '/standings', label: 'Standings' },
  { href: '/picks', label: 'Picks' },
];
const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__bar">
    <a href="/" class="header__logo">
      <span class="header__logo-icon">☠</span>
      <div class="header__logo-text">
        <span class="header__logo-title mk-glow-text">Last Man Standing</span>
        <span class="header__logo-sub">{game.subtitle}</span>
      </div>
    </a>

    <button
      type="button"
      class="header__menu-btn"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="header__menu-icon" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="header__nav">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['header__link', { 'header__link--active': currentPath === item.href }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.header');
  const menuBtn = document.querySelector('.header__menu-btn');

  function setMenuOpen(open: boolean) {
    header?.classList.toggle('header--open', open);
    menuBtn?.setAttribute('aria-expanded', String(open));
    menuBtn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.classList.toggle('menu-open', open);
  }

  menuBtn?.addEventListener('click', () => {
    setMenuOpen(!header?.classList.contains('header--open'));
  });

  document.getElementById('site-nav')?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  window.matchMedia('(min-width: 769px)').addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false);
  });
</script>

<style>
  .header {
    border-bottom: 1px solid rgba(255, 26, 26, 0.3);
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header__bar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    flex: 1;
  }

  .header__logo-icon {
    font-size: 1.85rem;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px var(--red-fire));
  }

  .header__logo-text {
    min-width: 0;
  }

  .header__logo-title {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    line-height: 1.05;
    color: var(--red-fire);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header__logo-sub {
    display: block;
    font-size: 0.7rem;
    color: var(--gold-dim);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header__menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgba(255, 26, 26, 0.35);
    background: rgba(255, 26, 26, 0.08);
    color: var(--text-primary);
    cursor: pointer;
    flex-shrink: 0;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }

  .header__menu-icon,
  .header__menu-icon::before,
  .header__menu-icon::after {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .header__menu-icon {
    position: relative;
  }

  .header__menu-icon::before,
  .header__menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .header__menu-icon::before {
    top: -6px;
  }

  .header__menu-icon::after {
    top: 6px;
  }

  .header--open .header__menu-icon {
    background: transparent;
  }

  .header--open .header__menu-icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .header--open .header__menu-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .header__link {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    padding: 0.5rem 1.1rem;
    color: var(--text-muted);
    transition: color 0.2s, background 0.2s;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
    white-space: nowrap;
  }

  .header__link:hover,
  .header__link--active {
    color: var(--text-primary);
    background: rgba(255, 69, 69, 0.12);
  }

  .header__link--active {
    color: var(--red-fire);
  }

  @media (max-width: 768px) {
    .header__bar {
      padding: 0.75rem 1rem;
    }

    .header__logo {
      flex: 1;
    }

    .header__logo-title {
      font-size: 1.2rem;
    }

    .header__logo-sub {
      font-size: 0.62rem;
      letter-spacing: 0.08em;
    }

    .header__menu-btn {
      display: flex;
    }

    .header__nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.35rem;
      margin-left: 0;
      padding: 0.35rem 0 0.15rem;
      border-top: 1px solid rgba(255, 26, 26, 0.2);
    }

    .header--open .header__nav {
      display: flex;
    }

    .header__link {
      width: 100%;
      padding: 0.9rem 1rem;
      font-size: 1.15rem;
      text-align: center;
    }
  }

  @media (max-width: 380px) {
    .header__logo-sub {
      display: none;
    }
  }
</style>
