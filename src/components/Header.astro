---
import { game } from '../data/game';

const nav = [
  { href: '/enter', label: 'Submit Pick' },
  { href: '/', label: 'Arena' },
  { href: '/standings', label: 'Standings' },
  { href: '/picks', label: 'Picks' },
];
const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__inner">
    <a href="/" class="header__logo">
      <span class="header__logo-icon">☠</span>
      <div>
        <span class="header__logo-title mk-glow-text">Last Man Standing</span>
        <span class="header__logo-sub">{game.subtitle}</span>
      </div>
    </a>
    <nav class="header__nav">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['header__link', { 'header__link--active': currentPath === item.href }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid rgba(255, 26, 26, 0.3);
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header__logo-icon {
    font-size: 2rem;
    filter: drop-shadow(0 0 8px var(--red-fire));
  }

  .header__logo-title {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    line-height: 1;
    color: var(--red-fire);
  }

  .header__logo-sub {
    display: block;
    font-size: 0.75rem;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .header__nav {
    display: flex;
    gap: 0.5rem;
  }

  .header__link {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.12em;
    padding: 0.5rem 1.2rem;
    color: var(--text-muted);
    transition: color 0.2s, background 0.2s;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }

  .header__link:hover,
  .header__link--active {
    color: var(--red-fire);
    background: rgba(255, 26, 26, 0.1);
  }
</style>
