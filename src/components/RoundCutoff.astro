---
import { formatScheduleTime } from '../utils/schedule';

interface Props {
  round: number;
  cutoffAt: string;
  firstKickoffAt: string;
  firstMatchNumber: number;
  picksOpen: boolean;
}

const { round, cutoffAt, firstKickoffAt, firstMatchNumber, picksOpen } = Astro.props;
const cutoffLabel = formatScheduleTime(cutoffAt);
const kickoffLabel = formatScheduleTime(firstKickoffAt);
const detailText =
  round === 1
    ? `Deadline 20:00 UK · First match #${firstMatchNumber} at ${kickoffLabel}`
    : `90 min before first kick-off · Match #${firstMatchNumber} at ${kickoffLabel}`;
---

<div
  class:list={['round-cutoff', 'mk-panel', { 'round-cutoff--closed': !picksOpen }]}
  data-cutoff-at={cutoffAt}
>
  <p class="round-cutoff__label">Pick deadline</p>
  <p class="round-cutoff__time">{cutoffLabel}</p>
  <p
    class:list={['round-cutoff__status', picksOpen ? 'round-cutoff__status--open' : 'round-cutoff__status--closed']}
    data-cutoff-status
  >
    {picksOpen ? 'Picks open' : 'Picks closed'}
  </p>
  <p class="round-cutoff__detail">{detailText}</p>
</div>

<style>
  .round-cutoff {
    padding: 1rem 1.25rem;
    text-align: center;
    border: 1px solid rgba(255, 215, 0, 0.25);
  }

  .round-cutoff--closed {
    border-color: rgba(255, 69, 69, 0.35);
  }

  .round-cutoff__label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.35rem;
  }

  .round-cutoff__time {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    line-height: 1.25;
    color: var(--gold);
  }

  .round-cutoff__status {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-top: 0.5rem;
    text-transform: uppercase;
  }

  .round-cutoff__status--open {
    color: var(--green-alive);
  }

  .round-cutoff__status--closed {
    color: var(--red-fire);
  }

  .round-cutoff__detail {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: 0.6rem;
    line-height: 1.5;
  }
</style>
