---
import type { RoundMatch } from '../data/game';
import { getRoundInfo } from '../data/rounds';
import { formatScheduleTime, getRoundSchedule } from '../utils/schedule';
import { getRoundPhase, phaseLabel } from '../utils/engine';

interface Props {
  matches: RoundMatch[];
  currentRound: number;
  totalRounds?: number;
}

const { matches, currentRound, totalRounds = 8 } = Astro.props;
const now = Date.now();
const rounds = [...new Set(matches.map((m) => m.round))].sort((a, b) => a - b);
---

<div class="timeline">
  {rounds.map((round) => {
    const roundMatches = matches.filter((m) => m.round === round);
    const info = getRoundInfo(round);
    const schedule = getRoundSchedule(round, matches);
    const isCurrent = round === currentRound;
    const isPast = round < currentRound;
    return (
      <div
        class:list={['timeline__round', { 'timeline__round--current': isCurrent, 'timeline__round--past': isPast }]}
        data-round={round}
      >
        <div class="timeline__marker">
          <span class="timeline__number">{round}</span>
        </div>
        <div class="timeline__content">
          <h4 class="timeline__title">
            {info?.name ?? `Round ${round}`}
            {isCurrent && <span class="timeline__live">LIVE</span>}
          </h4>
          <p class="timeline__matches">
            {roundMatches.length} matches
            {info?.dates && <span> · {info.dates}</span>}
          </p>
          {schedule && (
            <>
              <p class="timeline__cutoff">
                Picks close {formatScheduleTime(schedule.cutoffAt)}
              </p>
              <p class="timeline__opens">
                Opens {formatScheduleTime(schedule.opensAt)}
              </p>
              <p class="timeline__phase">
                {phaseLabel(getRoundPhase(round, matches, totalRounds, now))}
              </p>
            </>
          )}
        </div>
      </div>
    );
  })}
</div>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline__round {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    position: relative;
    opacity: 0.4;
  }

  .timeline__round--past,
  .timeline__round--current {
    opacity: 1;
  }

  .timeline__round:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 40px;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--red-blood), transparent);
  }

  .timeline__marker {
    width: 32px;
    height: 32px;
    border: 2px solid var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    background: var(--bg-dark);
    z-index: 1;
  }

  .timeline__round--current .timeline__marker {
    border-color: var(--red-fire);
    box-shadow: 0 0 15px rgba(255, 26, 26, 0.5);
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .timeline__round--past .timeline__marker {
    border-color: var(--gold-dim);
    background: rgba(184, 134, 11, 0.2);
  }

  .timeline__number {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
  }

  .timeline__title {
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .timeline__live {
    font-size: 0.65rem;
    background: var(--red-fire);
    color: white;
    padding: 0.1rem 0.4rem;
    letter-spacing: 0.1em;
    animation: pulse-glow 1.5s ease-in-out infinite;
  }

  .timeline__matches {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .timeline__cutoff {
    font-size: 0.75rem;
    color: var(--gold);
    margin-top: 0.25rem;
  }

  .timeline__opens,
  .timeline__phase {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }
</style>
