---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { gameConfig } from '../lib/game-config';
import { rounds } from '../data/rounds';
---

<Layout title="Admin" description="Tournament admin">
  <main class="admin-page">
    <div class="container">
      <header class="page-header">
        <p class="page-kicker mk-gold-text">Sub-Zero Control</p>
        <h1 class="page-title mk-glow-text">Admin</h1>
        <p class="page-sub">Enter match results to update eliminations and standings.</p>
      </header>

      <section id="login-section" class="admin-panel mk-panel">
        <h2 class="section-title mk-gold-text">Sign in</h2>
        <form id="login-form" class="admin-form">
          <label class="field">
            <span class="field__label">Username</span>
            <input type="text" id="admin-user" class="field__input" autocomplete="username" required />
          </label>
          <label class="field">
            <span class="field__label">Password</span>
            <input type="password" id="admin-pass" class="field__input" autocomplete="current-password" required />
          </label>
          <button type="submit" class="admin-btn">Enter</button>
        </form>
        <p id="login-error" class="admin-error" hidden></p>
      </section>

      <section id="admin-section" class="admin-dashboard" hidden>
        <div class="admin-toolbar mk-panel">
          <div class="admin-toolbar__left">
            <label class="field field--inline">
              <span class="field__label">LMS round</span>
              <select id="round-filter" class="field__input">
                {rounds.map((r) => (
                  <option value={r.round}>{r.round}. {r.name}</option>
                ))}
              </select>
            </label>
            <p id="round-summary" class="round-summary"></p>
          </div>
          <div class="admin-toolbar__right">
            <button type="button" id="reset-btn" class="admin-btn admin-btn--danger">Clear all data</button>
            <button type="button" id="logout-btn" class="admin-btn admin-btn--ghost">Sign out</button>
          </div>
        </div>

        <section class="admin-panel mk-panel players-admin">
          <h2 class="section-title mk-gold-text">Players &amp; picks</h2>
          <p class="players-admin__hint">
            Override closed deadlines — add late entrants or assign picks for the selected LMS round.
          </p>

          <form id="add-player-form" class="add-player-form">
            <label class="field">
              <span class="field__label">New player name</span>
              <input type="text" id="new-player-name" class="field__input" placeholder="e.g. Steven" minlength="2" maxlength="40" />
            </label>
            <label class="field">
              <span class="field__label">Round <span id="add-player-round-label">1</span> team (optional)</span>
              <select id="new-player-team" class="field__input">
                <option value="">Add without a pick</option>
              </select>
            </label>
            <button type="submit" class="admin-btn" id="add-player-btn">Add player</button>
          </form>

          <div id="player-admin-list" class="player-admin-list"></div>
        </section>

        <section class="admin-panel mk-panel extend-admin">
          <h2 class="section-title mk-gold-text">Extend pick deadline</h2>
          <p class="extend-admin__hint">
            Override the pick deadline for a round. Teams in matches that kick off before the new deadline are blocked for new picks — existing picks are kept.
          </p>
          <div class="extend-admin__form">
            <label class="field">
              <span class="field__label">Round</span>
              <select id="extend-round" class="field__input">
                {rounds.map((r) => (
                  <option value={r.round}>{r.round}. {r.name}</option>
                ))}
              </select>
            </label>
            <label class="field">
              <span class="field__label">New deadline (UK time)</span>
              <input type="datetime-local" id="extend-deadline" class="field__input" />
            </label>
            <div class="extend-admin__actions">
              <button type="button" id="extend-midnight-btn" class="admin-btn admin-btn--ghost">Midnight tonight</button>
              <button type="button" id="extend-save-btn" class="admin-btn">Save extension</button>
              <button type="button" id="extend-clear-btn" class="admin-btn admin-btn--ghost">Clear extension</button>
            </div>
          </div>
          <p id="extend-summary" class="extend-admin__summary"></p>
        </section>

        <section class="admin-panel mk-panel prize-admin">
          <h2 class="section-title mk-gold-text">Prize pool</h2>
          <form id="prize-form" class="prize-form">
            <label class="field">
              <span class="field__label">Winner takes</span>
              <input
                type="text"
                id="prize-amount"
                class="field__input"
                placeholder="e.g. £500"
                maxlength="40"
              />
            </label>
            <button type="submit" class="admin-btn">Save prize</button>
          </form>
          <p class="prize-admin__hint">Shown on the Arena and other pages. Leave blank to hide.</p>
        </section>

        <p id="admin-status" class="admin-status" hidden></p>
        <div id="match-admin-list" class="match-admin-list"></div>
      </section>

    </div>
  </main>
  <Footer showHome />
</Layout>

<script>
  import { gameConfig } from '../lib/game-config';
  import { getTeam } from '../data/game';
  import { getActiveRound, resolveGameState } from '../utils/engine';
  import { formatScheduleTime, getRoundSchedule, getTeamsBlockedBeforeCutoff, getNextDayMidnightLocal, getUkTimeOnKickoffDay } from '../utils/schedule';
  import { applyResults } from '../lib/apply-results';
  import type { ResultsState } from '../types/results';
  import type { RoundMatch } from '../data/game';
  import { loadPoolSettings, savePrizeAmount, saveRoundExtension, clearRoundExtension } from '../lib/pool-settings-store';
  import { scheduleOptionsFromSettings } from '../lib/schedule-options';
  import { getTeamsPlayingInRound } from '../utils/engine';
  import { adminAddPlayer, adminSetPick } from '../lib/admin-pool-store';
  import { loadPoolState } from '../lib/pool-store';
  import type { PoolState } from '../types/pool';
  import type { PoolSettings } from '../types/pool-settings';
  import {
    adminLogin,
    clearAdminSession,
    getAdminToken,
    loadResults,
    persistResultsLocally,
    resetAllData,
    resultsApiAvailable,
    saveMatchResult,
    syncLocalResultsToApi,
  } from '../lib/results-store';

  const loginSection = document.getElementById('login-section') as HTMLElement;
  const adminSection = document.getElementById('admin-section') as HTMLElement;
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const loginError = document.getElementById('login-error') as HTMLElement;
  const roundFilter = document.getElementById('round-filter') as HTMLSelectElement;
  const matchList = document.getElementById('match-admin-list') as HTMLElement;
  const roundSummary = document.getElementById('round-summary') as HTMLElement;
  const adminStatus = document.getElementById('admin-status') as HTMLElement;
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;
  const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
  const prizeForm = document.getElementById('prize-form') as HTMLFormElement;
  const prizeInput = document.getElementById('prize-amount') as HTMLInputElement;
  const addPlayerForm = document.getElementById('add-player-form') as HTMLFormElement;
  const newPlayerName = document.getElementById('new-player-name') as HTMLInputElement;
  const newPlayerTeam = document.getElementById('new-player-team') as HTMLSelectElement;
  const addPlayerRoundLabel = document.getElementById('add-player-round-label') as HTMLElement;
  const playerAdminList = document.getElementById('player-admin-list') as HTMLElement;
  const extendRound = document.getElementById('extend-round') as HTMLSelectElement;
  const extendDeadline = document.getElementById('extend-deadline') as HTMLInputElement;
  const extendMidnightBtn = document.getElementById('extend-midnight-btn') as HTMLButtonElement;
  const extendSaveBtn = document.getElementById('extend-save-btn') as HTMLButtonElement;
  const extendClearBtn = document.getElementById('extend-clear-btn') as HTMLButtonElement;
  const extendSummary = document.getElementById('extend-summary') as HTMLElement;

  const baseMatches = gameConfig.matches;
  const allTeams = gameConfig.teams;
  let resultsState: ResultsState = { version: 1, results: {} };
  let poolState: PoolState = { version: 2, entries: {} };
  let poolSettings: PoolSettings = { version: 2, prizeAmount: '', roundExtensions: {} };
  let savingMatch: number | null = null;
  let savingPlayer: string | null = null;
  let roundFiltersSynced = false;

  function scheduleOptions() {
    return scheduleOptionsFromSettings(poolSettings);
  }

  function setStatus(message: string, type: 'ok' | 'error' | 'info' = 'info') {
    adminStatus.hidden = false;
    adminStatus.textContent = message;
    adminStatus.className = `admin-status admin-status--${type}`;
  }

  function showDashboard() {
    loginSection.hidden = true;
    adminSection.hidden = false;
  }

  function showLogin() {
    loginSection.hidden = false;
    adminSection.hidden = true;
    roundFiltersSynced = false;
  }

  function currentMatches(): RoundMatch[] {
    return applyResults(baseMatches, resultsState);
  }

  function currentLmsRound(): number {
    return getActiveRound(
      currentMatches(),
      gameConfig.totalRounds,
      Date.now(),
      scheduleOptions(),
    );
  }

  function syncRoundFilters() {
    if (roundFiltersSynced) return;
    const round = String(currentLmsRound());
    roundFilter.value = round;
    extendRound.value = round;
    roundFiltersSynced = true;
  }

  function matchResult(match: RoundMatch) {
    if (match.isDraw) return { type: 'draw' as const };
    if (match.winnerId) return { type: 'winner' as const, winnerId: match.winnerId };
    return { type: 'pending' as const };
  }

  function missingFeederNote(match: RoundMatch): string {
    const missing: number[] = [];
    if (!match.homeTeamId && match.homeLabel) {
      const m = match.homeLabel.match(/^Match (\d+) Winner$/);
      if (m) missing.push(Number(m[1]));
    }
    if (!match.awayTeamId && match.awayLabel) {
      const m = match.awayLabel.match(/^Match (\d+) Winner$/);
      if (m) missing.push(Number(m[1]));
    }
    if (missing.length === 0) return '';
    const nums = [...new Set(missing)].sort((a, b) => a - b);
    return `<p class="match-admin__tbd">Waiting on earlier result${nums.length > 1 ? 's' : ''} for match${nums.length > 1 ? 'es' : ''} ${nums.join(', ')}. If these are already settled, open admin via <code>http://localhost:8888</code> (pnpm dev:netlify), not plain Astro.</p>`;
  }

  function renderMatches() {
    const round = Number(roundFilter.value);
    const matches = currentMatches().filter((m) => m.round === round);
    const withTeams = matches.filter((m) => m.homeTeamId && m.awayTeamId).length;
    const scored = matches.filter((m) => m.winnerId || m.isDraw).length;

    roundSummary.textContent = `${scored}/${matches.length} results entered · ${withTeams} matches with known teams`;

    matchList.innerHTML = matches
      .map((match) => {
        const home = match.homeTeamId ? getTeam(match.homeTeamId) : null;
        const away = match.awayTeamId ? getTeam(match.awayTeamId) : null;
        const homeName = home?.name ?? match.homeLabel ?? 'TBD';
        const awayName = away?.name ?? match.awayLabel ?? 'TBD';
        const result = matchResult(match);
        const canScore = !!(match.homeTeamId && match.awayTeamId);
        const kickoff = match.kickoffAt ? formatScheduleTime(match.kickoffAt) : '';
        const busy = savingMatch === match.matchNumber;

        const knockout = match.round >= 4;
        const resultLabel =
          result.type === 'draw' && !knockout
            ? 'Draw'
            : result.type === 'winner'
              ? getTeam(result.winnerId)?.short ?? result.winnerId
              : 'Pending';

        const drawBtn = knockout
          ? ''
          : `<button type="button" class="result-btn ${result.type === 'draw' ? 'result-btn--active' : ''}" data-action="draw" data-match="${match.matchNumber}" ${busy ? 'disabled' : ''}>Draw</button>`;

        const actions = canScore
          ? `<div class="match-admin__actions">
              <button type="button" class="result-btn ${result.type === 'winner' && result.winnerId === match.homeTeamId ? 'result-btn--active' : ''}" data-action="home" data-match="${match.matchNumber}" ${busy ? 'disabled' : ''}>
                ${home?.short ?? 'Home'} advances
              </button>
              ${drawBtn}
              <button type="button" class="result-btn ${result.type === 'winner' && result.winnerId === match.awayTeamId ? 'result-btn--active' : ''}" data-action="away" data-match="${match.matchNumber}" ${busy ? 'disabled' : ''}>
                ${away?.short ?? 'Away'} advances
              </button>
              <button type="button" class="result-btn result-btn--clear" data-action="clear" data-match="${match.matchNumber}" ${busy ? 'disabled' : ''}>Clear</button>
            </div>`
          : `<p class="match-admin__tbd">Teams TBD — set result once bracket is confirmed.</p>`;
        const feederNote = !canScore ? missingFeederNote(match) : '';

        return `<article class="match-admin mk-panel ${result.type !== 'pending' ? 'match-admin--scored' : ''}">
          <div class="match-admin__head">
            <span class="match-admin__label">${match.label} · #${match.matchNumber}</span>
            <span class="match-admin__result">${resultLabel}</span>
          </div>
          <p class="match-admin__teams">${homeName} vs ${awayName}</p>
          ${kickoff ? `<p class="match-admin__kickoff">${kickoff}</p>` : ''}
          ${feederNote || actions}
        </article>`;
      })
      .join('');
  }

  function teamsForPlayer(round: number, playerId: string) {
    const playing = getTeamsPlayingInRound(round, currentMatches(), allTeams);
    const currentPick = poolState.entries[playerId]?.picks.find((p) => p.round === round);
    if (currentPick && !playing.some((t) => t.id === currentPick.teamId)) {
      const team = allTeams.find((t) => t.id === currentPick.teamId);
      if (team) return [...playing, team];
    }
    return playing;
  }

  function populateTeamSelect(select: HTMLSelectElement, round: number, playerId = '__new__', selectedId = '') {
    const teams = teamsForPlayer(round, playerId);
    const keepFirst = select.options[0]?.value === '';
    select.innerHTML = keepFirst
      ? '<option value="">Add without a pick</option>'
      : '<option value="">No pick</option>';
    for (const team of teams) {
      const opt = document.createElement('option');
      opt.value = team.id;
      opt.textContent = team.name;
      select.appendChild(opt);
    }
    if (selectedId && [...select.options].some((o) => o.value === selectedId)) {
      select.value = selectedId;
    }
  }

  function renderExtensionSummary() {
    const round = Number(extendRound.value);
    const opts = scheduleOptions();
    const schedule = getRoundSchedule(round, baseMatches, opts);
    if (!schedule) {
      extendSummary.textContent = '';
      return;
    }

    const defaultSchedule = getRoundSchedule(round, baseMatches, {});
    const isExtended = defaultSchedule && schedule.cutoffAt !== defaultSchedule.cutoffAt;
    const blocked = getTeamsBlockedBeforeCutoff(round, baseMatches, schedule.cutoffAt);
    const blockedNames = [...blocked]
      .map((id) => allTeams.find((t) => t.id === id)?.name)
      .filter(Boolean);

    let text = `Round ${round} picks close ${formatScheduleTime(schedule.cutoffAt)}`;
    if (isExtended) {
      text += ` (extended from ${formatScheduleTime(defaultSchedule!.cutoffAt)})`;
    }
    if (blockedNames.length > 0) {
      text += `. Blocked for new picks: ${blockedNames.join(', ')}.`;
    }
    extendSummary.textContent = text;
  }

  function ukIsoToDatetimeLocal(iso: string): string {
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Europe/London',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(new Date(iso));
    const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '00';
    return `${get('year')}-${get('month')}-${get('day')}T${get('hour')}:${get('minute')}`;
  }

  function datetimeLocalToUkIso(value: string): string {
    const [datePart, timePart] = value.split('T');
    const [y, m, d] = datePart.split('-').map(Number);
    const [hh, mi] = timePart.split(':').map(Number);
    return getUkTimeOnKickoffDay(`${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}T12:00:00Z`, hh, mi);
  }

  function eligiblePlayerIds(round: number): Set<string> {
    const players = Object.values(poolState.entries).map((entry) => ({
      id: entry.playerId,
      name: entry.name,
      picks: entry.picks.map((p) => ({ round: p.round, teamId: p.teamId })),
    }));
    const matches = currentMatches();
    const roundOpensAt = getRoundSchedule(round, matches, scheduleOptions())?.opensAt;
    const resolved = resolveGameState(
      players,
      matches,
      gameConfig.totalRounds,
      roundOpensAt ? new Date(roundOpensAt).getTime() : Date.now(),
      scheduleOptions(),
    );
    return new Set(resolved.players.filter((p) => !p.eliminated).map((p) => p.id));
  }

  function renderPlayers() {
    const round = Number(roundFilter.value);
    addPlayerRoundLabel.textContent = String(round);
    populateTeamSelect(newPlayerTeam, round);

    const aliveIds = round > 1 && round !== 8 ? eligiblePlayerIds(round) : null;
    const entries = Object.values(poolState.entries)
      .filter((entry) => !aliveIds || aliveIds.has(entry.playerId))
      .sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));

    if (entries.length === 0) {
      playerAdminList.innerHTML =
        round > 1
          ? '<p class="players-admin__empty">No surviving players for this round.</p>'
          : '<p class="players-admin__empty">No players registered yet.</p>';
      return;
    }

    playerAdminList.innerHTML = entries
      .map((entry) => {
        const pick = entry.picks.find((p) => p.round === round);
        const team = pick ? allTeams.find((t) => t.id === pick.teamId) : null;
        const busy = savingPlayer === entry.playerId;
        const available = teamsForPlayer(round, entry.playerId);
        const teamOptions = available
          .map((t) => {
            const selected = pick?.teamId === t.id ? 'selected' : '';
            return `<option value="${t.id}" ${selected}>${t.name}</option>`;
          })
          .join('');

        return `<article class="player-admin mk-panel">
          <div class="player-admin__head">
            <span class="player-admin__name">${entry.name}</span>
            <span class="player-admin__pick">${team ? team.short : '—'}</span>
          </div>
          <div class="player-admin__actions">
            <select class="field__input player-admin__team" data-player-id="${entry.playerId}" ${busy ? 'disabled' : ''}>
              <option value="">No pick</option>
              ${teamOptions}
            </select>
            <button type="button" class="admin-btn player-admin__save" data-save-player="${entry.playerId}" ${busy ? 'disabled' : ''}>Save pick</button>
          </div>
        </article>`;
      })
      .join('');
  }

  async function refreshResults() {
    const apiOk = await resultsApiAvailable();
    const [{ state }, results, settings] = await Promise.all([
      loadPoolState(),
      loadResults(),
      loadPoolSettings(),
    ]);
    poolState = state;
    resultsState = results;
    poolSettings = settings;

    const synced = apiOk ? await syncLocalResultsToApi() : 0;
    if (synced > 0) {
      resultsState = await loadResults();
    }

    prizeInput.value = settings.prizeAmount ?? '';
    syncRoundFilters();
    renderMatches();
    renderPlayers();
    renderExtensionSummary();
    syncExtendDeadlineInput();

    if (!apiOk) {
      setStatus(
        'Results API unavailable on this port. Use http://localhost:8888/admin (pnpm dev:netlify) so R16/QF results load.',
        'error',
      );
    } else if (synced > 0) {
      setStatus(`Synced ${synced} locally saved result${synced === 1 ? '' : 's'} to shared storage.`, 'ok');
    }
  }

  function syncExtendDeadlineInput() {
    const round = Number(extendRound.value);
    const schedule = getRoundSchedule(round, baseMatches, scheduleOptions());
    if (schedule) {
      extendDeadline.value = ukIsoToDatetimeLocal(schedule.cutoffAt);
    }
  }

  function applyLocalMatchResult(matchNumber: number, action: string) {
    const key = String(matchNumber);
    const nextResults = { ...resultsState.results };
    const liveMatch = currentMatches().find((m) => m.matchNumber === matchNumber);

    if (action === 'clear') {
      delete nextResults[key];
    } else if (action === 'draw') {
      nextResults[key] = { isDraw: true };
    } else if (liveMatch) {
      const winnerId = action === 'home' ? liveMatch.homeTeamId : liveMatch.awayTeamId;
      if (!winnerId) return;
      nextResults[key] = { winnerId };
    } else {
      return;
    }

    resultsState = {
      ...resultsState,
      results: nextResults,
      updatedAt: new Date().toISOString(),
    };
    persistResultsLocally(resultsState);
  }

  async function handleResultAction(matchNumber: number, action: string) {
    const match = currentMatches().find((m) => m.matchNumber === matchNumber);
    if (!match?.homeTeamId || !match.awayTeamId) return;

    if (action === 'draw' && match.round >= 4) {
      setStatus('Knockout matches cannot end in a draw — pick the team that advances.', 'error');
      return;
    }

    let payload: Parameters<typeof saveMatchResult>[0];

    if (action === 'home') {
      payload = { matchNumber, winnerId: match.homeTeamId };
    } else if (action === 'away') {
      payload = { matchNumber, winnerId: match.awayTeamId };
    } else if (action === 'draw') {
      payload = { matchNumber, isDraw: true };
    } else if (action === 'clear') {
      payload = { matchNumber, clear: true };
    } else {
      return;
    }

    applyLocalMatchResult(matchNumber, action);
    savingMatch = matchNumber;
    renderMatches();

    try {
      const result = await saveMatchResult(payload);
      if (result.ok) {
        resultsState = result.state ?? resultsState;
        setStatus(
          result.localOnly
            ? `Match #${matchNumber} saved locally (use pnpm dev:netlify for shared storage).`
            : `Match #${matchNumber} updated.`,
          'ok',
        );
      } else {
        resultsState = await loadResults();
        setStatus(result.error ?? 'Could not save result.', 'error');
      }
    } catch {
      setStatus(`Match #${matchNumber} saved locally.`, 'ok');
    } finally {
      savingMatch = null;
      renderMatches();
    }
  }

  matchList.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-action]') as HTMLElement | null;
    if (!btn) return;
    const matchNumber = Number(btn.dataset.match);
    const action = btn.dataset.action;
    if (matchNumber && action) void handleResultAction(matchNumber, action);
  });

  roundFilter.addEventListener('change', () => {
    renderMatches();
    renderPlayers();
  });

  addPlayerForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const round = Number(roundFilter.value);
    const name = newPlayerName.value.trim();
    const teamId = newPlayerTeam.value || undefined;

    addPlayerForm.querySelector('button')!.setAttribute('disabled', 'true');
    const result = await adminAddPlayer({
      name,
      ...(teamId ? { round, teamId } : {}),
    });
    addPlayerForm.querySelector('button')!.removeAttribute('disabled');

    if (result.ok && result.state) {
      poolState = result.state;
      newPlayerName.value = '';
      newPlayerTeam.value = '';
      setStatus(teamId ? `${name} added with Round ${round} pick.` : `${name} added.`, 'ok');
      renderPlayers();
    } else if (result.ok) {
      poolState = (await loadPoolState()).state;
      newPlayerName.value = '';
      newPlayerTeam.value = '';
      setStatus(teamId ? `${name} added with Round ${round} pick.` : `${name} added.`, 'ok');
      renderPlayers();
    } else {
      setStatus(result.error ?? 'Could not add player.', 'error');
    }
  });

  playerAdminList.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-save-player]') as HTMLElement | null;
    if (!btn) return;

    const playerId = btn.dataset.savePlayer!;
    const row = btn.closest('.player-admin');
    const select = row?.querySelector('.player-admin__team') as HTMLSelectElement | null;
    if (!select?.value) {
      setStatus('Select a team first.', 'error');
      return;
    }

    const round = Number(roundFilter.value);
    savingPlayer = playerId;
    renderPlayers();

    const result = await adminSetPick({
      playerId,
      round,
      teamId: select.value,
    });

    savingPlayer = null;

    if (result.ok) {
      poolState = result.state ?? (await loadPoolState()).state;
      setStatus('Pick saved.', 'ok');
    } else {
      setStatus(result.error ?? 'Could not save pick.', 'error');
    }

    renderPlayers();
  });

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    loginError.hidden = true;

    const username = (document.getElementById('admin-user') as HTMLInputElement).value.trim();
    const password = (document.getElementById('admin-pass') as HTMLInputElement).value;

    const result = await adminLogin(username, password);
    if (!result.ok) {
      loginError.hidden = false;
      loginError.textContent = result.error ?? 'Login failed.';
      return;
    }

    showDashboard();
    await refreshResults();
  });

  prizeForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const result = await savePrizeAmount(prizeInput.value);
    if (result.ok) {
      setStatus('Prize amount saved.', 'ok');
    } else {
      setStatus(result.error ?? 'Could not save prize.', 'error');
    }
  });

  extendRound.addEventListener('change', () => {
    syncExtendDeadlineInput();
    renderExtensionSummary();
  });

  extendMidnightBtn.addEventListener('click', () => {
    const round = Number(extendRound.value);
    const schedule = getRoundSchedule(round, baseMatches, {});
    if (!schedule?.firstKickoffAt) return;
    const midnight = getNextDayMidnightLocal(schedule.firstKickoffAt);
    extendDeadline.value = ukIsoToDatetimeLocal(midnight);
  });

  extendSaveBtn.addEventListener('click', async () => {
    const round = Number(extendRound.value);
    if (!extendDeadline.value) {
      setStatus('Choose a deadline.', 'error');
      return;
    }
    const cutoffAt = datetimeLocalToUkIso(extendDeadline.value);
    extendSaveBtn.disabled = true;
    const result = await saveRoundExtension(round, cutoffAt);
    extendSaveBtn.disabled = false;
    if (result.ok && result.settings) {
      poolSettings = result.settings;
      renderExtensionSummary();
      renderPlayers();
      setStatus(`Round ${round} deadline extended to ${formatScheduleTime(cutoffAt)}.`, 'ok');
    } else {
      setStatus(result.error ?? 'Could not save extension.', 'error');
    }
  });

  extendClearBtn.addEventListener('click', async () => {
    const round = Number(extendRound.value);
    extendClearBtn.disabled = true;
    const result = await clearRoundExtension(round);
    extendClearBtn.disabled = false;
    if (result.ok && result.settings) {
      poolSettings = result.settings;
      syncExtendDeadlineInput();
      renderExtensionSummary();
      renderPlayers();
      setStatus(`Round ${round} extension cleared.`, 'ok');
    } else {
      setStatus(result.error ?? 'Could not clear extension.', 'error');
    }
  });

  resetBtn.addEventListener('click', async () => {
    if (!confirm('Clear all player entries and match results? This cannot be undone.')) return;
    resetBtn.disabled = true;
    const result = await resetAllData();
    resetBtn.disabled = false;
    if (result.ok) {
      resultsState = { version: 1, results: {} };
      poolState = { version: 2, entries: {} };
      prizeInput.value = '';
      setStatus('All pool data cleared.', 'ok');
      renderMatches();
      renderPlayers();
    } else {
      setStatus(result.error ?? 'Could not clear data.', 'error');
    }
  });

  logoutBtn.addEventListener('click', () => {
    clearAdminSession();
    showLogin();
    loginForm.reset();
  });

  if (getAdminToken()) {
    showDashboard();
    void refreshResults();
  }
</script>

