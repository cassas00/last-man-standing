---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrizeBanner from '../components/PrizeBanner.astro';
import { gameConfig } from '../lib/game-config';
---

<Layout title="Submit Pick" description="Register or submit your pick for the current round.">
  <Header />
  <main class="enter-page">
    <PrizeBanner />
    <div class="container">
      <header class="page-header">
        <p class="page-kicker mk-gold-text" id="page-kicker">Loading…</p>
        <h1 class="page-title mk-glow-text" id="page-title">Submit Pick</h1>
        <p class="page-sub" id="page-sub"></p>
        <p class="page-deadline" id="page-deadline" hidden></p>
      </header>

      <div id="enter-status" class="enter-status mk-panel" hidden></div>

      <div class="enter-grid">
        <section class="enter-form-section mk-panel">
          <h2 class="section-title mk-gold-text" id="form-title">Your Pick</h2>
          <form id="enter-form" class="enter-form">
            <label class="field" id="field-player">
              <span class="field__label">Player</span>
              <select name="playerId" id="player-slot" class="field__input" required>
                <option value="">Select player…</option>
              </select>
            </label>

            <label class="field" id="field-name" hidden>
              <span class="field__label">Your name</span>
              <input
                type="text"
                name="name"
                id="player-name"
                class="field__input"
                placeholder="e.g. Mike Henderson"
                minlength="2"
                maxlength="40"
              />
            </label>

            <label class="field">
              <span class="field__label" id="team-label">Team</span>
              <select name="teamId" id="player-team" class="field__input" required>
                <option value="">Pick a team…</option>
              </select>
              <p class="field__hint" id="team-hint">Teams you've used in a previous round are hidden.</p>
            </label>

            <button type="submit" class="enter-submit" id="enter-submit">Lock In Pick</button>
          </form>
          <p class="enter-note" id="enter-note"></p>
        </section>

        <section>
          <h2 class="section-title mk-gold-text" id="roster-title">Roster</h2>
          <div id="roster-list" class="roster-list"></div>
        </section>
      </div>

    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { applyResults } from '../lib/apply-results';
  import { loadPoolState, submitPick } from '../lib/pool-store';
  import { loadResults } from '../lib/results-store';
  import { loadPoolSettings } from '../lib/pool-settings-store';
  import { scheduleOptionsFromSettings } from '../lib/schedule-options';
  import {
    getAvailableTeamsForPlayer,
    getTeamsTakenInRound,
    isRegistrationOpen,
  } from '../lib/pool-validation';
  import { resolveGameState } from '../utils/engine';
  import { areRoundPicksRevealed, formatScheduleTime, getRoundSchedule } from '../utils/schedule';
  import { getTeam } from '../data/game';

  const configEl = document.getElementById('lms-config');
  const config = configEl ? JSON.parse(configEl.textContent!) : null;

  const form = document.getElementById('enter-form') as HTMLFormElement;
  const statusEl = document.getElementById('enter-status') as HTMLElement;
  const rosterEl = document.getElementById('roster-list') as HTMLElement;
  const submitBtn = document.getElementById('enter-submit') as HTMLButtonElement;
  const noteEl = document.getElementById('enter-note') as HTMLElement;
  const slotSelect = document.getElementById('player-slot') as HTMLSelectElement;
  const nameInput = document.getElementById('player-name') as HTMLInputElement;
  const teamSelect = document.getElementById('player-team') as HTMLSelectElement;
  const fieldName = document.getElementById('field-name') as HTMLElement;
  const fieldPlayer = document.getElementById('field-player') as HTMLElement;
  const teamLabel = document.getElementById('team-label') as HTMLElement;
  const pageKicker = document.getElementById('page-kicker') as HTMLElement;
  const pageSub = document.getElementById('page-sub') as HTMLElement;
  const pageDeadline = document.getElementById('page-deadline') as HTMLElement;
  const formTitle = document.getElementById('form-title') as HTMLElement;
  const rosterTitle = document.getElementById('roster-title') as HTMLElement;
  const formSection = document.querySelector('.enter-form-section') as HTMLElement;

  const teams = config?.teams as Array<{ id: string; short: string; color: string; name: string }>;
  const matches = config?.matches;
  const totalRounds = config?.totalRounds as number;

  let currentRound = 1;
  let picksOpen = false;
  let activeScheduleOptions = scheduleOptionsFromSettings({ version: 2, prizeAmount: '' });

  function setStatus(message: string, type: 'ok' | 'error' | 'info' = 'info') {
    statusEl.hidden = false;
    statusEl.textContent = message;
    statusEl.className = `enter-status mk-panel enter-status--${type}`;
  }

  function populateTeamOptions(
    state: import('../types/pool').PoolState,
    playerId: string,
    liveMatches = matches,
  ) {
    const sortTeams = (list: typeof teams) =>
      [...list].sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));

    const baseAvailable = getAvailableTeamsForPlayer(
      state,
      playerId,
      currentRound,
      liveMatches,
      teams,
      activeScheduleOptions,
    );
    const currentPick = state.entries[playerId]?.picks.find((p) => p.round === currentRound);
    const currentPickUnavailable =
      !!currentPick && !baseAvailable.some((t) => t.id === currentPick.teamId);
    let available = sortTeams(baseAvailable);

    if (currentPickUnavailable) {
      const team = teams.find((t) => t.id === currentPick.teamId);
      if (team) available = sortTeams([...baseAvailable, team]);
    }

    teamSelect.innerHTML = '<option value="">Pick a team…</option>';
    for (const team of available) {
      const opt = document.createElement('option');
      opt.value = team.id;
      opt.textContent =
        currentPickUnavailable && currentPick.teamId === team.id
          ? `${team.name} — your pick`
          : team.name;
      teamSelect.appendChild(opt);
    }

    if (currentPick) {
      teamSelect.value = currentPick.teamId;
    }
  }

  function populatePlayerOptions(
    players: Array<{ id: string; name: string }>,
    newPlayerLabel = 'Select player…',
  ) {
    slotSelect.innerHTML = `<option value="">${newPlayerLabel}</option>`;
    for (const player of players) {
      const opt = document.createElement('option');
      opt.value = player.id;
      opt.textContent = player.name;
      slotSelect.appendChild(opt);
    }
  }

  function syncNameField(state: import('../types/pool').PoolState) {
    if (currentRound !== 1) {
      fieldName.hidden = true;
      nameInput.required = false;
      return;
    }

    const existingId = slotSelect.value;
    if (existingId && state.entries[existingId]) {
      fieldName.hidden = true;
      nameInput.required = false;
      nameInput.value = state.entries[existingId].name;
    } else {
      fieldName.hidden = false;
      nameInput.required = true;
    }
  }

  function renderRoster(
    state: import('../types/pool').PoolState,
    aliveIds: Set<string>,
    liveMatches: typeof matches,
  ) {
    const picksRevealed = areRoundPicksRevealed(currentRound, liveMatches, Date.now(), activeScheduleOptions);
    const takenThisRound = getTeamsTakenInRound(state, currentRound);

    const entries = Object.values(state.entries);
    const rosterEntries = currentRound === 1
      ? entries
      : entries.filter((e) => aliveIds.has(e.playerId));

    rosterEl.innerHTML = rosterEntries
      .map((entry) => {
        const pick = entry.picks.find((p) => p.round === currentRound);
        const isSelected = slotSelect.value === entry.playerId;

        if (!picksRevealed) {
          return `<div class="roster-card mk-panel ${isSelected ? 'roster-card--mine' : ''}">
            <span class="roster-card__name">${entry.name}</span>
          </div>`;
        }

        const team = pick ? getTeam(pick.teamId) : null;
        return `<div class="roster-card mk-panel ${pick ? 'roster-card--taken' : ''} ${isSelected ? 'roster-card--mine' : ''}">
          <span class="roster-card__name">${entry.name}</span>
          ${
            team
              ? `<span class="roster-card__team" style="--team-color: ${team.color}">${team.short}</span>`
              : `<span class="roster-card__pending">—</span>`
          }
        </div>`;
      })
      .join('');

    teamLabel.textContent = `Round ${currentRound} team`;
    const hintEl = document.getElementById('team-hint')!;
    if (currentRound >= 4) {
      hintEl.textContent = picksRevealed
        ? `${takenThisRound.size} pick${takenThisRound.size !== 1 ? 's' : ''} submitted. Only Round of 32 teams you have not picked before.`
        : "Pick a Round of 32 team you have not used in an earlier round.";
    } else {
      hintEl.textContent = picksRevealed
        ? `${takenThisRound.size} pick${takenThisRound.size !== 1 ? 's' : ''} submitted this round.`
        : 'All picks stay hidden until the deadline. You can still update yours below.';
    }
  }

  async function refresh(savedState?: import('../types/pool').PoolState) {
    const [{ state, source }, results, settings] = savedState
      ? [{ state: savedState, source: 'api' as const }, await loadResults(), await loadPoolSettings()]
      : await Promise.all([loadPoolState(), loadResults(), loadPoolSettings()]);
    const scheduleOptions = scheduleOptionsFromSettings(settings);
    activeScheduleOptions = scheduleOptions;
    const { playersFromPool } = await import('../lib/pool-store');
    const players = playersFromPool(state);
    const liveMatches = applyResults(matches, results);

    const resolved = resolveGameState(players, liveMatches, totalRounds, Date.now(), scheduleOptions);
    const survivors = resolved.players.filter((p) => !p.eliminated && p.name !== '—');
    currentRound = resolved.currentRound;
    picksOpen = resolved.picksOpen;
    const schedule = getRoundSchedule(currentRound, liveMatches, scheduleOptions);

    pageKicker.textContent = `Round ${currentRound}`;
    rosterTitle.textContent = currentRound === 1 ? `Players (${Object.keys(state.entries).length})` : 'Survivors';

    if (currentRound === 1) {
      pageSub.textContent =
        'Select your name from the list or register as a new player, then lock in your Round 1 team.';
      fieldPlayer.hidden = false;
      slotSelect.required = false;
      formTitle.textContent = 'Register';
    } else {
      pageSub.textContent =
        `Submit your Round ${currentRound} pick. Select your name and a team — you can't reuse a team from an earlier round.`;
      fieldPlayer.hidden = false;
      slotSelect.required = true;
      formTitle.textContent = `Round ${currentRound} Pick`;
    }

    if (schedule) {
      pageDeadline.hidden = false;
      pageDeadline.innerHTML = picksOpen
        ? `Picks close <strong>${formatScheduleTime(schedule.cutoffAt)}</strong>`
        : `Picks closed · deadline was ${formatScheduleTime(schedule.cutoffAt)}`;
    }

    noteEl.textContent =
      source === 'local'
        ? 'Dev mode: saved to this browser only. Use pnpm dev:netlify for shared storage.'
        : 'Picks are saved for everyone and stay hidden until the deadline. Select your name each time you submit.';

    const registeredPlayers = Object.values(state.entries)
      .sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }))
      .map((e) => ({ id: e.playerId, name: e.name }));

    const round1Players = registeredPlayers.filter((p) =>
      state.entries[p.id]?.picks.some((pick) => pick.round === 1),
    );

    const isNewRegistration = currentRound === 1 && !slotSelect.value;
    const registrationClosed =
      !isRegistrationOpen(Date.now(), activeScheduleOptions) && isNewRegistration;

    const activePlayerId = slotSelect.value || '';

    if (registrationClosed) {
      formSection.hidden = true;
      setStatus(
        'Registration is closed. The Round 1 deadline has passed — only players who registered in time can continue.',
        'info',
      );
    } else {
      formSection.hidden = false;

      if (currentRound === 1) {
        populatePlayerOptions(registeredPlayers, 'Register as new player…');
      } else {
        populatePlayerOptions(round1Players);
      }

      syncNameField(state);

      populateTeamOptions(state, activePlayerId, liveMatches);

      const formDisabled = !picksOpen;
      form.querySelectorAll('input, select, button').forEach((el) => {
        (el as HTMLInputElement).disabled = formDisabled;
      });

      if (!picksOpen) {
        setStatus(resolved.phaseLabel, 'info');
      } else if (source === 'local' && round1Players.length === 0 && currentRound > 1) {
        setStatus(
          'No players loaded — plain pnpm dev cannot reach the pool API. Run pnpm dev:netlify to use live entries.',
          'info',
        );
        submitBtn.disabled = true;
      } else if (currentRound > 1 && round1Players.length === 0) {
        setStatus('No players registered yet.', 'info');
        submitBtn.disabled = true;
      } else if (currentRound > 1 && survivors.length === 0) {
        setStatus('No surviving registered players yet.', 'info');
        submitBtn.disabled = true;
      } else {
        setStatus(`Round ${currentRound} picks are open.`, 'ok');
        submitBtn.disabled = false;
      }
    }

    renderRoster(state, new Set(survivors.map((p) => p.id)), liveMatches);

    if (!registrationClosed) {
      const checkId = slotSelect.value;
      const existingPick = checkId
        ? state.entries[checkId]?.picks.find((p) => p.round === currentRound)
        : null;
      submitBtn.textContent = existingPick ? 'Update Pick' : 'Lock In Pick';
    }
  }

  slotSelect.addEventListener('change', async () => {
    const [{ state }, results] = await Promise.all([loadPoolState(), loadResults()]);
    syncNameField(state);
    populateTeamOptions(state, slotSelect.value, applyResults(matches, results));
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!picksOpen) return;

    const { state } = await loadPoolState();

    let playerId = slotSelect.value;
    if (currentRound === 1 && !playerId) {
      playerId = crypto.randomUUID();
    }

    if (!playerId) {
      setStatus('Select your name from the list.', 'error');
      return;
    }
    if (!teamSelect.value) return;

    if (currentRound === 1 && !slotSelect.value) {
      const name = nameInput.value.trim();
      if (name.length < 2) {
        setStatus('Enter your name (at least 2 characters).', 'error');
        return;
      }
    }

    submitBtn.disabled = true;
    const result = await submitPick({
      playerId,
      round: currentRound,
      teamId: teamSelect.value,
      name: currentRound === 1 && !slotSelect.value ? nameInput.value.trim() : undefined,
    });

    if (result.ok) {
      setStatus('Pick saved!', 'ok');
      await refresh(result.state);
    } else {
      setStatus(result.error ?? 'Could not save pick.', 'error');
      submitBtn.disabled = !picksOpen;
    }
  });

  refresh();
  setInterval(refresh, 30_000);
</script>

<style>
  .enter-page {
    padding: 2rem 0 3rem;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-kicker {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .page-title {
    font-size: clamp(2.5rem, 8vw, 4rem);
    color: var(--red-fire);
    margin: 0.5rem 0;
  }

  .page-sub {
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .page-deadline {
    margin-top: 1rem;
    color: var(--gold);
    font-size: 0.95rem;
  }

  .enter-status {
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    text-align: center;
    font-size: 0.9rem;
  }

  .enter-status--ok {
    border-color: rgba(57, 255, 20, 0.4);
    color: var(--green-alive);
  }

  .enter-status--error {
    border-color: rgba(255, 26, 26, 0.5);
    color: var(--red-fire);
  }

  .enter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .enter-form-section {
    padding: 1.5rem;
  }

  .section-title {
    font-size: 1.2rem;
    margin-bottom: 1.25rem;
  }

  .enter-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field__label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .field__hint {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
    line-height: 1.45;
  }

  .field__input {
    width: 100%;
    padding: 0.8rem 1rem;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-primary);
    font-size: 1rem;
  }

  .field__input:focus {
    outline: none;
    border-color: var(--gold-dim);
    box-shadow: 0 0 0 2px rgba(240, 210, 100, 0.15);
  }

  .field__input:disabled {
    opacity: 0.5;
  }

  .enter-submit {
    margin-top: 0.5rem;
    padding: 1rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem;
    letter-spacing: 0.15em;
    background: var(--red-fire);
    color: white;
    border: none;
    cursor: pointer;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    transition: opacity 0.2s;
  }

  .enter-submit:hover:not(:disabled) {
    opacity: 0.9;
  }

  .enter-submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .enter-note {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .roster-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .roster-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    opacity: 0.7;
  }

  .roster-card--taken {
    opacity: 1;
  }

  .roster-card--mine {
    border-color: var(--gold);
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.15);
  }

  .roster-card__name {
    font-size: 1rem;
    font-weight: 600;
  }


  .roster-card__team {
    font-family: 'Bebas Neue', sans-serif;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--team-color);
    color: var(--team-color);
    font-size: 0.9rem;
  }

  .roster-card__pending {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .enter-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
