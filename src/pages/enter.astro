---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { gameConfig } from '../lib/game-config';
import { playerSlots } from '../data/game';
---

<Layout title="Submit Pick" description="Register or submit your pick for the current round.">
  <Header />
  <main class="enter-page">
    <div class="container">
      <header class="page-header">
        <p class="page-kicker mk-gold-text" id="page-kicker">Loading…</p>
        <h1 class="page-title mk-glow-text" id="page-title">Submit Pick</h1>
        <p class="page-sub" id="page-sub"></p>
        <p class="page-deadline" id="page-deadline" hidden></p>
      </header>

      <div id="enter-status" class="enter-status mk-panel" hidden></div>

      <div class="enter-grid">
        <section class="enter-form-section mk-panel">
          <h2 class="section-title mk-gold-text" id="form-title">Your Pick</h2>
          <form id="enter-form" class="enter-form">
            <label class="field" id="field-slot">
              <span class="field__label" id="slot-label">Fighter codename</span>
              <select name="playerId" id="player-slot" class="field__input" required>
                <option value="">Select…</option>
              </select>
            </label>

            <label class="field" id="field-name">
              <span class="field__label">Your name</span>
              <input
                type="text"
                name="name"
                id="player-name"
                class="field__input"
                placeholder="e.g. Mike Henderson"
                minlength="2"
                maxlength="40"
              />
            </label>

            <label class="field">
              <span class="field__label" id="team-label">Team</span>
              <select name="teamId" id="player-team" class="field__input" required>
                <option value="">Pick a team…</option>
              </select>
              <p class="field__hint" id="team-hint">Teams already picked this round or used before are hidden.</p>
            </label>

            <button type="submit" class="enter-submit" id="enter-submit">Lock In Pick</button>
          </form>
          <p class="enter-note" id="enter-note"></p>
        </section>

        <section>
          <h2 class="section-title mk-gold-text" id="roster-title">Roster</h2>
          <div id="roster-list" class="roster-list"></div>
        </section>
      </div>

      <p class="enter-footer">
        <a href="/" class="enter-link">Go to Arena →</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  import { loadPoolState, submitPick, getMySlotId } from '../lib/pool-store';
  import {
    getAvailableTeamsForPlayer,
    getAliveRegisteredPlayers,
    getTeamsTakenInRound,
    isPickWindowOpen,
  } from '../lib/pool-validation';
  import { resolveGameState } from '../utils/engine';
  import { formatScheduleTime, getRoundSchedule } from '../utils/schedule';
  import { getTeam } from '../data/game';

  const configEl = document.getElementById('lms-config');
  const config = configEl ? JSON.parse(configEl.textContent!) : null;

  const form = document.getElementById('enter-form') as HTMLFormElement;
  const statusEl = document.getElementById('enter-status') as HTMLElement;
  const rosterEl = document.getElementById('roster-list') as HTMLElement;
  const submitBtn = document.getElementById('enter-submit') as HTMLButtonElement;
  const noteEl = document.getElementById('enter-note') as HTMLElement;
  const slotSelect = document.getElementById('player-slot') as HTMLSelectElement;
  const nameInput = document.getElementById('player-name') as HTMLInputElement;
  const teamSelect = document.getElementById('player-team') as HTMLSelectElement;
  const fieldName = document.getElementById('field-name') as HTMLElement;
  const fieldSlot = document.getElementById('field-slot') as HTMLElement;
  const slotLabel = document.getElementById('slot-label') as HTMLElement;
  const teamLabel = document.getElementById('team-label') as HTMLElement;
  const pageKicker = document.getElementById('page-kicker') as HTMLElement;
  const pageSub = document.getElementById('page-sub') as HTMLElement;
  const pageDeadline = document.getElementById('page-deadline') as HTMLElement;
  const formTitle = document.getElementById('form-title') as HTMLElement;
  const rosterTitle = document.getElementById('roster-title') as HTMLElement;

  const teams = config?.teams as Array<{ id: string; short: string; color: string; name: string }>;
  const slots = config?.slots as Array<{ id: string; alias: string }>;
  const matches = config?.matches;
  const totalRounds = config?.totalRounds as number;

  let currentRound = 1;
  let picksOpen = false;

  function setStatus(message: string, type: 'ok' | 'error' | 'info' = 'info') {
    statusEl.hidden = false;
    statusEl.textContent = message;
    statusEl.className = `enter-status mk-panel enter-status--${type}`;
  }

  function populateTeamOptions(state: import('../types/pool').PoolState, playerId: string) {
    const available = getAvailableTeamsForPlayer(state, playerId, currentRound, matches, teams);
    const currentPick = state.entries[playerId]?.picks.find((p) => p.round === currentRound);

    teamSelect.innerHTML = '<option value="">Pick a team…</option>';
    for (const team of available) {
      const opt = document.createElement('option');
      opt.value = team.id;
      opt.textContent = `${team.name} (${team.short})`;
      teamSelect.appendChild(opt);
    }

    if (currentPick && !available.some((t) => t.id === currentPick.teamId)) {
      const team = teams.find((t) => t.id === currentPick.teamId);
      if (team) {
        const opt = document.createElement('option');
        opt.value = team.id;
        opt.textContent = `${team.name} (${team.short}) — your pick`;
        opt.selected = true;
        teamSelect.appendChild(opt);
      }
    } else if (currentPick) {
      teamSelect.value = currentPick.teamId;
    }
  }

  function populatePlayerOptions(state: import('../types/pool').PoolState) {
    const mySlot = getMySlotId();
    slotSelect.innerHTML = '<option value="">Select…</option>';

    if (currentRound === 1) {
      for (const slot of slots) {
        const entry = state.entries[slot.id];
        const taken = !!entry && mySlot !== slot.id;
        const opt = document.createElement('option');
        opt.value = slot.id;
        opt.textContent = taken ? `${slot.alias} — ${entry!.name}` : slot.alias;
        opt.disabled = taken;
        slotSelect.appendChild(opt);
      }
    } else {
      const alive = getAliveRegisteredPlayers(state);
      for (const player of alive) {
        const opt = document.createElement('option');
        opt.value = player.id;
        opt.textContent = `${player.alias} — ${player.name}`;
        slotSelect.appendChild(opt);
      }
    }
  }

  function renderRoster(state: import('../types/pool').PoolState) {
    const takenThisRound = getTeamsTakenInRound(state, currentRound);

    rosterEl.innerHTML = (slots ?? [])
      .map((slot) => {
        const entry = state.entries[slot.id];
        const pick = entry?.picks.find((p) => p.round === currentRound);
        const team = pick ? getTeam(pick.teamId) : null;
        const isMine = getMySlotId() === slot.id;
        if (currentRound > 1 && !entry) return '';

        return `<div class="roster-card mk-panel ${pick ? 'roster-card--taken' : ''} ${isMine ? 'roster-card--mine' : ''}">
          <span class="roster-card__alias">${slot.alias}</span>
          <span class="roster-card__name">${entry ? entry.name : 'Open slot'}</span>
          ${
            team
              ? `<span class="roster-card__team" style="--team-color: ${team.color}">${team.short}</span>`
              : `<span class="roster-card__pending">${picksOpen ? 'No pick yet' : '—'}</span>`
          }
        </div>`;
      })
      .join('');

    const takenCount = takenThisRound.size;
    teamLabel.textContent = `Round ${currentRound} team`;
    document.getElementById('team-hint')!.textContent =
      `${takenCount} team${takenCount !== 1 ? 's' : ''} taken this round. No duplicates allowed.`;
  }

  async function refresh() {
    const { state, source } = await loadPoolState();
    const players = (slots ?? []).map((slot) => {
      const entry = state.entries[slot.id];
      return {
        id: slot.id,
        alias: slot.alias,
        name: entry?.name ?? '—',
        picks: entry?.picks.map((p) => ({ round: p.round, teamId: p.teamId })) ?? [],
      };
    });

    const resolved = resolveGameState(players, matches, totalRounds, Date.now());
    currentRound = resolved.currentRound;
    picksOpen = isPickWindowOpen(currentRound);
    const schedule = getRoundSchedule(currentRound, matches);

    pageKicker.textContent = `Round ${currentRound}`;
    rosterTitle.textContent = currentRound === 1 ? `Fighters (${slots.length} slots)` : 'Survivors';

    if (currentRound === 1) {
      pageSub.textContent =
        'Choose your fighter codename, enter your name, and lock in your Round 1 team. No two players can pick the same team.';
      fieldName.style.display = '';
      nameInput.required = true;
      slotLabel.textContent = 'Fighter codename';
      formTitle.textContent = 'Register';
    } else {
      pageSub.textContent =
        `Submit your Round ${currentRound} pick. Select a surviving player and a team — no duplicates this round, and no team you've used before.`;
      fieldName.style.display = 'none';
      nameInput.required = false;
      slotLabel.textContent = 'Player';
      formTitle.textContent = `Round ${currentRound} Pick`;
    }

    if (schedule) {
      pageDeadline.hidden = false;
      pageDeadline.innerHTML = picksOpen
        ? `Picks close <strong>${formatScheduleTime(schedule.cutoffAt)}</strong>`
        : `Picks closed · deadline was ${formatScheduleTime(schedule.cutoffAt)}`;
    }

    noteEl.textContent =
      source === 'local'
        ? 'Dev mode: saved to this browser only. Use pnpm dev:netlify for shared storage.'
        : 'Picks are saved for everyone. Each team can only be picked once per round.';

    populatePlayerOptions(state);
    populateTeamOptions(state, slotSelect.value || getMySlotId() || '');

    const mySlot = getMySlotId();
    if (mySlot) {
      slotSelect.value = mySlot;
      const entry = state.entries[mySlot];
      if (entry) {
        if (currentRound === 1) nameInput.value = entry.name;
        populateTeamOptions(state, mySlot);
      }
    }

    renderRoster(state);

    const formDisabled = !picksOpen;
    form.querySelectorAll('input, select, button').forEach((el) => {
      (el as HTMLInputElement).disabled = formDisabled;
    });

    if (!picksOpen) {
      setStatus(resolved.phaseLabel, 'info');
    } else if (currentRound > 1 && getAliveRegisteredPlayers(state).length === 0) {
      setStatus('No surviving registered players yet.', 'info');
      submitBtn.disabled = true;
    } else {
      setStatus(`Round ${currentRound} picks are open.`, 'ok');
      submitBtn.disabled = false;
    }

    if (currentRound > 1) {
      const existingPick = slotSelect.value
        ? state.entries[slotSelect.value]?.picks.find((p) => p.round === currentRound)
        : null;
      submitBtn.textContent = existingPick ? 'Update Pick' : 'Lock In Pick';
    } else {
      submitBtn.textContent = state.entries[slotSelect.value]?.picks.some((p) => p.round === 1)
        ? 'Update Pick'
        : 'Lock In Pick';
    }
  }

  slotSelect.addEventListener('change', async () => {
    const { state } = await loadPoolState();
    populateTeamOptions(state, slotSelect.value);
    if (currentRound === 1) {
      const entry = state.entries[slotSelect.value];
      if (entry) nameInput.value = entry.name;
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!picksOpen) return;

    const playerId = slotSelect.value;
    const teamId = teamSelect.value;
    if (!playerId || !teamId) return;

    submitBtn.disabled = true;
    const result = await submitPick({
      playerId,
      round: currentRound,
      teamId,
      name: currentRound === 1 ? nameInput.value.trim() : undefined,
    });

    if (result.ok) {
      setStatus('Pick saved!', 'ok');
      await refresh();
    } else {
      setStatus(result.error ?? 'Could not save pick.', 'error');
      submitBtn.disabled = !picksOpen;
    }
  });

  refresh();
  setInterval(refresh, 30_000);
</script>

<style>
  .enter-page {
    padding: 2rem 0 3rem;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-kicker {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .page-title {
    font-size: clamp(2.5rem, 8vw, 4rem);
    color: var(--red-fire);
    margin: 0.5rem 0;
  }

  .page-sub {
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .page-deadline {
    margin-top: 1rem;
    color: var(--gold);
    font-size: 0.95rem;
  }

  .enter-status {
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    text-align: center;
    font-size: 0.9rem;
  }

  .enter-status--ok {
    border-color: rgba(57, 255, 20, 0.4);
    color: var(--green-alive);
  }

  .enter-status--error {
    border-color: rgba(255, 26, 26, 0.5);
    color: var(--red-fire);
  }

  .enter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .enter-form-section {
    padding: 1.5rem;
  }

  .section-title {
    font-size: 1.2rem;
    margin-bottom: 1.25rem;
  }

  .enter-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field__label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.35rem;
  }

  .field__hint {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  .field__input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 26, 26, 0.3);
    color: var(--text);
    font-size: 1rem;
  }

  .field__input:focus {
    outline: none;
    border-color: var(--red-fire);
    box-shadow: 0 0 10px rgba(255, 26, 26, 0.2);
  }

  .field__input:disabled {
    opacity: 0.5;
  }

  .enter-submit {
    margin-top: 0.5rem;
    padding: 1rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem;
    letter-spacing: 0.15em;
    background: var(--red-fire);
    color: white;
    border: none;
    cursor: pointer;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    transition: opacity 0.2s;
  }

  .enter-submit:hover:not(:disabled) {
    opacity: 0.9;
  }

  .enter-submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .enter-note {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .roster-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .roster-card {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    opacity: 0.7;
  }

  .roster-card--taken {
    opacity: 1;
  }

  .roster-card--mine {
    border-color: var(--gold);
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.15);
  }

  .roster-card__alias {
    font-family: 'Bebas Neue', sans-serif;
    color: var(--gold);
    letter-spacing: 0.1em;
  }

  .roster-card__name {
    font-size: 0.9rem;
  }

  .roster-card__team {
    font-family: 'Bebas Neue', sans-serif;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--team-color);
    color: var(--team-color);
    font-size: 0.9rem;
  }

  .roster-card__pending {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .enter-footer {
    text-align: center;
    margin-top: 2rem;
  }

  .enter-link {
    color: var(--gold);
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .enter-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
